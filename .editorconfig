root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
max_line_length = 100

# YAML forbids tabs for indentation per spec.
[*.{yaml,yml}]
indent_style = space
indent_size = 2

# `terraform fmt` enforces 2-space indentation.
[*.{tf,tftpl,tfvars,hcl}]
indent_style = space
indent_size = 2

# JSON parsers permit tabs but tooling commonly emits spaces; stay consistent.
[*.json]
indent_style = space
indent_size = 2

# Markdown nested lists rely on consistent space indentation.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off
